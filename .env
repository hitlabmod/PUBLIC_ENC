#####################################################################################################

# isi dengan nomor yang ingin anda jadikan bot, kode pairing muncul di log
PAIRING_NUMBER=

# nomor owner untuk penggunaan command khusus owner
OWNER=["6289681008411"]

#####################################################################################################
# Pengaturan Mode Bot
# `true` untuk pribadi dan `false` untuk publik
SELF=true

#####################################################################################################
# Pengaturan Penyimpanan
# opsional
WRITE_STORE=false

#####################################################################################################

#####################################################################################################
# Pengaturan Sticker Pack
packName=Sticker Dibuat Oleh : 
packPublish=Wilykun.

#####################################################################################################
# Pengaturan Fitur Bot

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto read story
# Jika diatur ke 'true', bot akan secara acak memutuskan apakah akan memberikan reaksi emoji atau tidak saat melihat status.
# Jika diatur ke 'false', bot akan selalu memberikan reaksi emoji saat melihat status.
# Jika diatur ke 'suram', bot akan selalu melihat status tanpa memberikan reaksi emoji.
AUTO_READ_STORY=false

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto-update
AUTO_UPDATE=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto typing
# Jika diatur ke 'true', bot akan menampilkan status mengetik saat menerima pesan.
# Jika diatur ke 'false', bot tidak akan menampilkan status mengetik.
ENABLE_TYPING=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto recording
# Jika diatur ke 'true', bot akan menampilkan status merekam saat menerima pesan.
# Jika diatur ke 'false', bot tidak akan menampilkan status merekam.
ENABLE_RECORDING=false

# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto online/auto read pesan
# Jika diatur ke 'true', bot akan menandai pesan sebagai telah diterima (ceklis dua abu-abu) dan selalu online.
# Jika diatur ke 'false', bot tidak akan menandai pesan sebagai telah diterima dan tidak selalu online.
AUTO_ONLINE_AUTO_READ_PESAN=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur selamat datang
# Jika diatur ke 'true', bot akan mengirim pesan selamat datang saat ada anggota baru yang masuk ke grup.
# Jika diatur ke 'false', bot tidak akan mengirim pesan selamat datang.
ENABLE_WELCOME_MESSAGE=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur selamat tinggal
# Jika diatur ke 'true', bot akan mengirim pesan selamat tinggal saat ada anggota yang keluar dari grup.
# Jika diatur ke 'false', bot tidak akan mengirim pesan selamat tinggal.
ENABLE_GOODBYE_MESSAGE=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur anti forwarded newsletter
ENABLE_ANTI_FORWARDED_NEWSLETTER=true

# pengaturan untuk mengaktifkan atau menonaktifkan fitur anti wa.me link
ENABLE_ANTI_WAME_LINK=true

# Pengaturan untuk memilih file emoticon
# Pilihan Name File Emoticon: 
#'Emot_Constum' (V1),
#'Emot_Langka' (V2)
#'Emot_Lengkap' (V3), 
EMOT_FILE=Emot_Constum

#####################################################################################################
# Pengaturan Penanganan Error jangan di false ntar error fatal
# pengaturan untuk mengaktifkan atau menonaktifkan penanganan uncaughtException dan unhandledRejection
HANDLE_ERRORS=true

#####################################################################################################
# Pengaturan Auto Kick
# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto kick
# Jika diatur ke 'true', bot akan mengeluarkan anggota yang melanggar aturan.
# Jika diatur ke 'false', bot tidak akan mengeluarkan anggota yang melanggar aturan.
AUTO_KICK_ENABLED=false

#####################################################################################################
# Pengaturan Auto Clear Session
# pengaturan untuk mengaktifkan atau menonaktifkan fitur auto clear session
# Jika diatur ke 'true', bot akan membersihkan sesi secara otomatis setiap interval yang ditentukan.
# Jika diatur ke 'false', bot tidak akan membersihkan sesi secara otomatis.
AUTO_CLEAR_SESSION_ENABLED=true

# Direktori sesi nama jangan di ubah
SESSION_DIR=session

# Interval pembersihan sesi dalam milidetik (contoh: 60000 untuk 1 menit)
# Untuk mengubah interval pembersihan sesi, ubah nilai CLEAR_INTERVAL.
# Contoh:
# 60000 untuk 1 menit
# 300000 untuk 5 menit
# 3600000 untuk 1 jam
# 7200000 untuk 2 jam
# 10800000 untuk 3 jam
# 14400000 untuk 4 jam
# 18000000 untuk 5 jam
CLEAR_INTERVAL=60000